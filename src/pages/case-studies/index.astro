---
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Navigation from '../../components/Navigation.astro';
import Footer from '../../components/Footer.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { breadcrumb } from '../../lib/schema';
import heroImage from '../../assets/case-studies/hero-wloskie-delikatesy.jpg';

const breadcrumbs = [
  { label: 'Strona główna', href: '/' },
  { label: 'Case studies' },
];

const schema = breadcrumb('Case studies', '/case-studies');

interface CaseStudy {
  slug: string;
  image: ImageMetadata;
  tag: string;
  title: string;
  excerpt: string;
  duration: string;
  kpis: { value: string; label: string }[];
}

const caseStudies: CaseStudy[] = [
  {
    slug: '/case-studies/wzrost-ruchu-organicznego-o-800-w-e-commerce-z-wloskimi-delikatesami',
    image: heroImage,
    tag: 'E-COMMERCE',
    title: 'Wzrost ruchu organicznego o 800% w e-commerce z włoskimi delikatesami',
    excerpt: 'W 24 miesiące zwiększyliśmy ruch organiczny o 800%, konwersję o 121% i udział organic w przychodach z 14% do 47%. Strategia: SEO techniczne, content hubs regionalne, programmatic SEO z ludzką redakcją i link building.',
    duration: '24 miesiące',
    kpis: [
      { value: '800%', label: 'wzrost ruchu' },
      { value: '390', label: 'słowa w TOP 3' },
      { value: '121%', label: 'wzrost konwersji' },
    ],
  },
];

const featured = caseStudies[0];
const rest = caseStudies.slice(1);
---

<BaseLayout
  title="Case Studies SEO - Zrealizowane projekty | Talem"
  description="Zobacz nasze case studies SEO dla e-commerce. Mierzalne wyniki, wzrosty ruchu organicznego i realny ROI. Sprawdź jak pomogliśmy naszym klientom."
  schema={schema}
>
  <Navigation />

  <main class="min-h-screen pt-24 pb-16 bg-gray-50">
    <div class="max-w-[1400px] mx-auto px-4 sm:px-6 lg:px-8">

      <!-- Breadcrumbs -->
      <Breadcrumbs items={breadcrumbs} />

      <!-- H1 Title -->
      <div class="mb-8">
        <h1 class="text-4xl lg:text-5xl font-bold text-[#191c1e] mb-4">
          Case Studies
        </h1>
        <p class="text-lg text-gray-600 max-w-2xl">
          Realne projekty, mierzalne rezultaty. Zobacz, jak nasze strategie SEO przekładały się na wzrost ruchu, widoczności i przychodów naszych klientów.
        </p>
      </div>

      <!-- Wyróżnione case study (pierwsze na liście) -->
      {featured && (
        <section class="mb-16">
          <a
            href={featured.slug}
            class="block bg-white rounded-xl overflow-hidden shadow-sm border border-gray-200 hover:shadow-lg transition-shadow duration-300 group"
          >
            <div class="grid lg:grid-cols-2 gap-0">
              <!-- Zdjęcie po lewej -->
              <div class="overflow-hidden h-full min-h-[400px] relative">
                <Picture
                  src={featured.image}
                  alt={featured.title}
                  widths={[400, 800, 1200]}
                  sizes="(max-width: 1024px) 100vw, 50vw"
                  class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700"
                  loading="eager"
                />
                <div class="absolute bottom-6 left-6 font-mono text-[0.75rem] font-bold tracking-[0.1em] text-white bg-black/50 backdrop-blur-md px-4 py-2 rounded-md uppercase z-10">
                  {featured.tag}
                </div>
              </div>

              <!-- Treść po prawej -->
              <div class="p-8 lg:p-12 flex flex-col justify-center">
                <span class="inline-block px-3 py-1 bg-accent/10 text-accent text-xs font-mono uppercase tracking-wider rounded-full mb-4 w-fit">
                  Najnowsze case study
                </span>

                <h2 class="text-2xl lg:text-3xl font-bold text-black leading-tight mb-4 group-hover:text-accent transition-colors">
                  {featured.title}
                </h2>

                <p class="text-gray-600 text-base leading-relaxed mb-6">
                  {featured.excerpt}
                </p>

                <div class="flex items-center gap-4 text-sm text-gray-500 mb-6">
                  <span class="flex items-center gap-1.5">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <circle cx="12" cy="12" r="10" />
                      <polyline points="12 6 12 12 16 14" />
                    </svg>
                    {featured.duration}
                  </span>
                </div>

                <div class="grid grid-cols-3 gap-4 pt-6 border-t-2 border-gray-100 mb-6">
                  {featured.kpis.map((kpi) => (
                    <div>
                      <div class="font-mono text-xl lg:text-[1.75rem] font-bold text-accent leading-none mb-1">
                        {kpi.value}
                      </div>
                      <div class="text-[0.7rem] text-gray-500 uppercase tracking-widest font-semibold">
                        {kpi.label}
                      </div>
                    </div>
                  ))}
                </div>

                <span class="inline-flex items-center gap-2 px-6 py-3 bg-accent text-white font-bold rounded-lg hover:bg-black transition-colors w-fit group/btn">
                  CZYTAJ CASE STUDY
                  <svg class="w-5 h-5 group-hover/btn:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path d="M5 12h14M12 5l7 7-7 7" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                  </svg>
                </span>
              </div>
            </div>
          </a>
        </section>
      )}

      <!-- Siatka pozostałych case studies -->
      {rest.length > 0 && (
        <section>
          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
            {rest.map((cs) => (
              <a
                href={cs.slug}
                class="group bg-white rounded-xl overflow-hidden shadow-sm border border-gray-200 hover:shadow-lg transition-shadow duration-300 flex flex-col"
              >
                <div class="relative min-h-[220px] overflow-hidden">
                  <Picture
                    src={cs.image}
                    alt={cs.title}
                    widths={[400, 800]}
                    sizes="(max-width: 768px) 100vw, 400px"
                    class="absolute inset-0 w-full h-full object-cover group-hover:scale-105 transition-transform duration-700"
                    loading="lazy"
                  />
                  <div class="absolute bottom-4 left-4 font-mono text-[0.65rem] font-bold tracking-[0.1em] text-white bg-black/50 backdrop-blur-md px-3 py-1.5 rounded-md uppercase z-10">
                    {cs.tag}
                  </div>
                </div>
                <div class="p-6 flex flex-col flex-grow">
                  <h3 class="font-bold text-lg text-black leading-snug mb-3 group-hover:text-accent transition-colors">
                    {cs.title}
                  </h3>
                  <p class="text-gray-600 text-sm leading-relaxed mb-4 flex-grow">
                    {cs.excerpt}
                  </p>
                  <div class="grid grid-cols-3 gap-2 pt-4 border-t border-gray-100">
                    {cs.kpis.map((kpi) => (
                      <div>
                        <div class="font-mono text-base font-bold text-accent leading-none mb-1">
                          {kpi.value}
                        </div>
                        <div class="text-[0.6rem] text-gray-500 uppercase tracking-wider font-semibold">
                          {kpi.label}
                        </div>
                      </div>
                    ))}
                  </div>
                </div>
              </a>
            ))}
          </div>
        </section>
      )}

    </div>
  </main>

  <Footer />
</BaseLayout>

---
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Navigation from '../../components/Navigation.astro';
import Footer from '../../components/Footer.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { breadcrumb } from '../../lib/schema';
import heroImage from '../../assets/case-studies/hero-wloskie-delikatesy.jpg';
import rumImage from '../../assets/case-studies/case-study-rum.png';

const breadcrumbs = [
  { label: 'Strona główna', href: '/' },
  { label: 'Case studies' },
];

const schema = breadcrumb('Case studies', '/case-studies');

interface CaseStudy {
  slug: string;
  image?: ImageMetadata;
  tag: string;
  title: string;
  excerpt: string;
  duration: string;
  kpis: { value: string; label: string }[];
}

const caseStudies: CaseStudy[] = [
  {
    slug: '/case-studies/real-user-monitoring-rum-wydajnosc-ecommerce',
    image: rumImage,
    tag: 'WYDAJNOŚĆ',
    title: 'Real User Monitoring: Jak przestaliśmy zgadywać i wskazaliśmy IT, co dokładnie psuje sprzedaż w e-commerce',
    excerpt: 'Projekt i wdrożenie systemu analityki wydajności opartego na danych od realnych użytkowników (RUM). Zgromadziliśmy ponad 329 000 zwalidowanych zdarzeń z 566 kluczowych adresów URL i wskazaliśmy IT konkretne błędy psujące sprzedaż.',
    duration: '9 tygodni + monitoring ciągły',
    kpis: [
      { value: '329k+', label: 'zwalidowane zdarzenia' },
      { value: '566', label: 'monitorowane URL' },
      { value: '5', label: 'warstw systemu' },
    ],
  },
  {
    slug: '/case-studies/wzrost-ruchu-organicznego-o-800-w-e-commerce-z-wloskimi-delikatesami',
    image: heroImage,
    tag: 'E-COMMERCE',
    title: 'Wzrost ruchu organicznego o 800% w e-commerce z włoskimi delikatesami',
    excerpt: 'W 24 miesiące zwiększyliśmy ruch organiczny o 800%, konwersję o 121% i udział organic w przychodach z 14% do 47%. Strategia: SEO techniczne, content hubs regionalne, programmatic SEO z ludzką redakcją i link building.',
    duration: '24 miesiące',
    kpis: [
      { value: '800%', label: 'wzrost ruchu' },
      { value: '390', label: 'słowa w TOP 3' },
      { value: '121%', label: 'wzrost konwersji' },
    ],
  },
];

---

<BaseLayout
  title="Case Studies SEO - Zrealizowane projekty | Talem"
  description="Zobacz nasze case studies SEO dla e-commerce. Mierzalne wyniki, wzrosty ruchu organicznego i realny ROI. Sprawdź jak pomogliśmy naszym klientom."
  schema={schema}
>
  <Navigation />

  <main class="min-h-screen pt-24 pb-16 bg-gray-50">
    <div class="max-w-[1400px] mx-auto px-4 sm:px-6 lg:px-8">

      <!-- Breadcrumbs -->
      <Breadcrumbs items={breadcrumbs} />

      <!-- H1 Title -->
      <div class="mb-8">
        <h1 class="text-4xl lg:text-5xl font-bold text-[#191c1e] mb-4">
          Case Studies
        </h1>
        <p class="text-lg text-gray-600 max-w-2xl">
          Realne projekty, mierzalne rezultaty. Zobacz, jak nasze strategie SEO przekładały się na wzrost ruchu, widoczności i przychodów naszych klientów.
        </p>
      </div>

      <!-- Siatka wszystkich case studies -->
      <section>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
          {caseStudies.map((cs) => (
            <a
              href={cs.slug}
              class="group bg-white rounded-xl overflow-hidden shadow-sm border border-gray-200 hover:shadow-lg transition-shadow duration-300 flex flex-col"
            >
              <div class="relative min-h-[280px] overflow-hidden">
                {cs.image ? (
                  <Picture
                    src={cs.image}
                    alt={cs.title}
                    widths={[400, 800]}
                    sizes="(max-width: 768px) 100vw, 600px"
                    class="absolute inset-0 w-full h-full object-cover group-hover:scale-105 transition-transform duration-700"
                    loading="lazy"
                  />
                ) : (
                  <div class="absolute inset-0 w-full h-full bg-gradient-to-br from-[#0a0c0d] via-[#191c1e] to-[#2a0a12] flex items-center justify-center">
                    <div class="absolute inset-0 opacity-[0.07]" style="background-image: linear-gradient(rgba(255,255,255,1) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,1) 1px, transparent 1px); background-size: 40px 40px;"></div>
                    <svg class="w-16 h-16 text-accent/40" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" d="M3 12h4l3-9 4 18 3-9h4" />
                    </svg>
                  </div>
                )}
                <div class="absolute bottom-4 left-4 font-mono text-[0.65rem] font-bold tracking-[0.1em] text-white bg-black/50 backdrop-blur-md px-3 py-1.5 rounded-md uppercase z-10">
                  {cs.tag}
                </div>
              </div>
              <div class="p-6 flex flex-col flex-grow">
                <h3 class="font-bold text-lg text-black leading-snug mb-3 group-hover:text-accent transition-colors">
                  {cs.title}
                </h3>
                <p class="text-gray-600 text-sm leading-relaxed mb-4 flex-grow">
                  {cs.excerpt}
                </p>
                <div class="flex items-center gap-4 text-sm text-gray-500 mb-4">
                  <span class="flex items-center gap-1.5">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <circle cx="12" cy="12" r="10" />
                      <polyline points="12 6 12 12 16 14" />
                    </svg>
                    {cs.duration}
                  </span>
                </div>
                <div class="grid grid-cols-3 gap-2 pt-4 border-t border-gray-100">
                  {cs.kpis.map((kpi) => (
                    <div>
                      <div class="font-mono text-base font-bold text-accent leading-none mb-1">
                        {kpi.value}
                      </div>
                      <div class="text-[0.6rem] text-gray-500 uppercase tracking-wider font-semibold">
                        {kpi.label}
                      </div>
                    </div>
                  ))}
                </div>
              </div>
            </a>
          ))}
        </div>
      </section>

    </div>
  </main>

  <Footer />
</BaseLayout>

---
import { Picture } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Navigation from '../../components/Navigation.astro';
import Footer from '../../components/Footer.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { breadcrumb } from '../../lib/schema';

import heroImage from '../../assets/case-studies/hero-wloskie-delikatesy.jpg';
import silosowaArchitektura from '../../assets/case-studies/silosowa-architektura.webp';
import widocznoscOrganiczna from '../../assets/case-studies/widocznosc-organiczna-od-poczatku-wspolpracy.png';
import wykresKolowy from '../../assets/case-studies/wykres-kolowy-podzial-kanalow-sprzedazy.png';
import zalamanieWidocznosci from '../../assets/case-studies/zalamanie-widocznosci-core-update.png';

const breadcrumbs = [
  { label: 'Strona główna', href: '/' },
  { label: 'Case studies', href: '/case-studies' },
  { label: 'Wzrost ruchu o 800% - włoskie delikatesy' },
];

const schema = [
  ...breadcrumb('Case studies', '/case-studies'),
  {
    "@type": "Article",
    "headline": "Wzrost ruchu organicznego o 800% w e-commerce z włoskimi delikatesami",
    "description": "Transformacja butikowego sklepu z włoskimi delikatesami premium — od 86% zależności od płatnych kanałów do 47% udziału ruchu organicznego w przychodach w 24 miesiące.",
    "url": "https://www.talem.eu/case-studies/wzrost-ruchu-organicznego-o-800-w-e-commerce-z-wloskimi-delikatesami",
    "author": { "@type": "Organization", "name": "Talem Technologies Sp. z o. o." },
    "publisher": { "@id": "https://www.talem.eu/#organization" },
  },
];
---

<BaseLayout
  title="Case Study SEO: +800% ruchu organicznego w e-commerce z włoskimi delikatesami | Talem"
  description="Jak w 24 miesiące zwiększyliśmy ruch organiczny sklepu z włoskimi delikatesami o 800%, a konwersję o 121%. Realne wyniki, taktyki, wnioski."
  schema={schema}
>
  <Navigation />

  <main class="min-h-screen pt-24 bg-white">
    <!-- Breadcrumbs -->
    <div class="max-w-[1400px] mx-auto px-4 sm:px-6 lg:px-8 mb-8">
      <Breadcrumbs items={breadcrumbs} />
    </div>

    <!-- Hero Section -->
    <section class="relative overflow-hidden mb-16 lg:mb-24">
      <!-- Background image with gradient overlay -->
      <div class="absolute inset-0 z-0">
        <Picture
          src={heroImage}
          alt="E-commerce z włoskimi delikatesami - case study SEO"
          widths={[400, 800, 1200, 1600, 1920]}
          sizes="100vw"
          class="w-full h-full object-cover"
          loading="eager"
          quality="high"
          fetchpriority="high"
        />
        <div class="absolute inset-0 bg-gradient-to-r from-black/90 via-black/75 to-black/40"></div>
        <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-transparent to-black/20"></div>
      </div>

      <!-- Decorative accent bar (left edge) -->
      <div class="absolute top-0 left-0 w-1.5 h-full bg-accent z-10 hidden sm:block"></div>

      <!-- Decorative geometric circle (top-right) -->
      <div class="absolute -top-32 -right-32 w-96 h-96 rounded-full border-2 border-accent/20 z-10 hidden lg:block"></div>
      <div class="absolute -top-16 -right-16 w-64 h-64 rounded-full border border-accent/10 z-10 hidden lg:block"></div>

      <!-- Content -->
      <div class="relative z-20 px-4 sm:px-6 lg:px-8 py-16 lg:py-28 max-w-[1400px] mx-auto">
        <div class="inline-block bg-accent px-3 py-1 text-white font-mono text-[0.75rem] font-semibold tracking-[0.05em] uppercase mb-6">
          E-COMMERCE CASE STUDY
        </div>
        <h1 class="font-display text-[2rem] md:text-[3.5rem] lg:text-[5rem] font-bold leading-[1.1] tracking-[-0.02em] text-white mb-8 max-w-4xl">
          Wzrost ruchu organicznego o 800% w e-commerce z włoskimi delikatesami
        </h1>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-8 border-t border-white/20 pt-8 max-w-5xl">
          <div>
            <p class="font-mono text-[0.75rem] uppercase tracking-[0.05em] text-gray-300 mb-2">Miesięczne sesje</p>
            <div class="flex items-baseline gap-4">
              <span class="font-body text-[3rem] lg:text-[4rem] font-extrabold leading-none tracking-[-0.04em] text-white">36k</span>
              <span class="text-accent-light font-bold text-lg">↑ 800%</span>
            </div>
            <p class="text-gray-300">z poziomu 4,000 / msc</p>
          </div>
          <div class="bg-white/10 backdrop-blur-md p-6 border-l-4 border-accent rounded-r-lg">
            <p class="font-mono text-[0.75rem] uppercase tracking-[0.05em] text-accent-light mb-2">30-second summary</p>
            <p class="font-body italic leading-relaxed text-white">W 24 miesiące zwiększyliśmy ruch organiczny o 800%, konwersję o 121% i udział organic w przychodach z 14% do 47%. Strategia: SEO techniczne, content hubs regionalne, programmatic SEO z ludzką redakcją i link building.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- Sticky Sidebar & Content Layout -->
    <div class="px-4 sm:px-6 lg:px-8 max-w-[1400px] mx-auto flex flex-col md:flex-row gap-8 lg:gap-16">
      <!-- Sidebar Navigation -->
      <aside class="hidden md:block w-56 lg:w-64 flex-shrink-0">
        <div class="sticky top-32 space-y-4">
          <p class="font-mono text-[0.75rem] uppercase tracking-[0.05em] text-gray-500 mb-6">Przegląd sekcji</p>
          <a class="flex items-center gap-3 text-gray-600 hover:text-accent border-l-2 border-gray-300 hover:border-accent pl-4 py-1 transition-all" href="#klient">Klient i start</a>
          <a class="flex items-center gap-3 text-gray-600 hover:text-accent border-l-2 border-gray-300 hover:border-accent pl-4 py-1 transition-all" href="#sytuacja">Sytuacja wyjściowa</a>
          <a class="flex items-center gap-3 text-gray-600 hover:text-accent border-l-2 border-gray-300 hover:border-accent pl-4 py-1 transition-all" href="#wyzwania">Wyzwania</a>
          <a class="flex items-center gap-3 text-gray-600 hover:text-accent border-l-2 border-gray-300 hover:border-accent pl-4 py-1 transition-all" href="#cele">Cele projektu</a>
          <a class="flex items-center gap-3 text-gray-600 hover:text-accent border-l-2 border-gray-300 hover:border-accent pl-4 py-1 transition-all" href="#strategia">Strategia (6 faz)</a>
          <a class="flex items-center gap-3 text-gray-600 hover:text-accent border-l-2 border-gray-300 hover:border-accent pl-4 py-1 transition-all" href="#trudnosci">Trudności i rozwiązania</a>
          <a class="flex items-center gap-3 text-gray-600 hover:text-accent border-l-2 border-gray-300 hover:border-accent pl-4 py-1 transition-all" href="#wyniki">Wyniki (24 mc)</a>
          <a class="flex items-center gap-3 text-gray-600 hover:text-accent border-l-2 border-gray-300 hover:border-accent pl-4 py-1 transition-all" href="#wnioski">Wnioski</a>
        </div>
      </aside>

      <!-- Main Body Content -->
      <div class="flex-grow space-y-16 lg:space-y-24 pb-16">

        <!-- Sekcja 1: Klient i punkt startowy -->
        <section class="scroll-mt-32" id="klient">
          <h2 class="font-body text-[2rem] lg:text-[3rem] font-bold leading-tight mb-8">Klient i punkt startowy projektu</h2>
          <div class="space-y-6 mb-10">
            <p class="text-lg text-gray-600 leading-relaxed">
              Projekt dotyczył butikowego sklepu e-commerce specjalizującego się w autentycznych włoskich produktach premium. Oferta obejmowała m.in.:
            </p>
            <ul class="space-y-3 text-gray-600 leading-relaxed pl-6 list-disc">
              <li>oliwę extra virgin z rodzinnych tłoczni w Toskanii,</li>
              <li>rzemieślnicze makarony produkowane z wykorzystaniem tradycyjnych metod, takich jak matryce z brązu i długie suszenie,</li>
              <li>sery długodojrzewające z certyfikatami DOP, w tym Parmigiano Reggiano 36M, Pecorino Sardo i Gorgonzola,</li>
              <li>wina z małych, rodzinnych winiarni z Piemontu i Wenecji Euganejskiej,</li>
              <li>sezonowe produkty premium, takie jak rzemieślnicze Panettone, oliwa z nowego zbioru oraz świeża trufla.</li>
            </ul>
            <p class="text-lg text-gray-600 leading-relaxed">
              Sklep działał na rynku od trzech lat. Miał solidne fundamenty: wysokiej jakości produkty, spójny wizerunek marki oraz lojalną grupę klientów regularnie dokonujących ponownych zakupów.
            </p>
            <p class="text-lg text-gray-600 leading-relaxed">
              Największym wyzwaniem była jednak widoczność organiczna. Ruch z bezpłatnych wyników wyszukiwania pozostawał na bardzo niskim poziomie – aż 86% użytkowników trafiało na stronę dzięki płatnym kanałom, takim jak Meta Ads i Google Ads. Jednocześnie koszt pozyskania klienta (CAC) systematycznie wzrastał ze względu na rosnącą konkurencję reklamową.
            </p>
            <p class="text-lg text-gray-600 leading-relaxed">
              Projekt rozpoczęliśmy z jasnym celem: zbudować trwały kanał pozyskiwania klientów z Google, który pozwoli ograniczyć zależność od płatnych kampanii i wykorzystać potencjał marki premium.
            </p>
          </div>
          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
            <div class="bg-gray-100 p-4 rounded-lg">
              <p class="font-mono text-[0.75rem] text-gray-500 mb-1">NASZ KLIENT</p>
              <p class="font-bold text-sm">Butikowy sklep internetowy z włoskimi delikatesami premium</p>
            </div>
            <div class="bg-gray-100 p-4 rounded-lg">
              <p class="font-mono text-[0.75rem] text-gray-500 mb-1">BRANŻA</p>
              <p class="font-bold text-sm">E-commerce spożywczy, segment premium / slow food</p>
            </div>
            <div class="bg-gray-100 p-4 rounded-lg">
              <p class="font-mono text-[0.75rem] text-gray-500 mb-1">CZAS TRWANIA</p>
              <p class="font-bold text-sm">24 miesiące (czerwiec 2024 – czerwiec 2026)</p>
            </div>
            <div class="bg-gray-100 p-4 rounded-lg">
              <p class="font-mono text-[0.75rem] text-gray-500 mb-1">ZAKRES</p>
              <p class="font-bold text-sm">SEO techniczne, contentowe, link building, CRO</p>
            </div>
          </div>
        </section>

        <!-- Sekcja 2: Sytuacja wyjściowa w liczbach -->
        <section class="scroll-mt-32" id="sytuacja">
          <h2 class="font-body text-[2rem] lg:text-[3rem] font-bold leading-tight mb-8">Sytuacja wyjściowa w liczbach</h2>
          <div class="overflow-x-auto">
            <table class="w-full text-left border-collapse">
              <thead>
                <tr class="border-b border-black">
                  <th class="py-4 font-mono text-[0.75rem] text-gray-500">METRYKA</th>
                  <th class="py-4 font-mono text-[0.75rem] text-gray-500">WARTOŚĆ NA START (CZERWIEC 2024)</th>
                </tr>
              </thead>
              <tbody class="text-base">
                <tr class="border-b border-gray-300"><td class="py-4 font-bold">Sesje organiczne / mc</td><td class="py-4">~4 000</td></tr>
                <tr class="border-b border-gray-300"><td class="py-4 font-bold">Frazy w TOP3</td><td class="py-4">28</td></tr>
                <tr class="border-b border-gray-300"><td class="py-4 font-bold">Frazy w TOP10 (Senuto)</td><td class="py-4">80</td></tr>
                <tr class="border-b border-gray-300"><td class="py-4 font-bold">Frazy w TOP50 (Senuto)</td><td class="py-4">340</td></tr>
                <tr class="border-b border-gray-300"><td class="py-4 font-bold">Domain Rating (Ahrefs)</td><td class="py-4">12</td></tr>
                <tr class="border-b border-gray-300"><td class="py-4 font-bold">Linkujące domeny</td><td class="py-4">34</td></tr>
                <tr class="border-b border-gray-300"><td class="py-4 font-bold">Konwersja z organic</td><td class="py-4">1,4%</td></tr>
                <tr class="border-b border-gray-300"><td class="py-4 font-bold">Średnia wartość koszyka</td><td class="py-4">187 zł</td></tr>
                <tr class="border-b border-gray-300"><td class="py-4 font-bold">Przychód z organic</td><td class="py-4">baza</td></tr>
                <tr class="border-b border-gray-300"><td class="py-4 font-bold">Udział organic w przychodach</td><td class="py-4">14%</td></tr>
                <tr class="border-b border-gray-300"><td class="py-4 font-bold">Uśredniony koszt pozyskania klienta (CAC)</td><td class="py-4">78 zł</td></tr>
                <tr><td class="py-4 font-bold">Core Web Vitals (mobile)</td><td class="py-4">LCP 4,2 s / CLS 0,18 / INP 340 ms</td></tr>
              </tbody>
            </table>
          </div>
        </section>

        <!-- Sekcja 3: Wyzwanie -->
        <section class="scroll-mt-32 bg-black p-8 lg:p-16 rounded-lg -mx-4 lg:mx-0" id="wyzwania">
          <h2 class="font-body text-[2rem] lg:text-[3rem] font-bold leading-tight text-white mb-8">Wyzwanie</h2>
          <p class="text-lg text-gray-400 leading-relaxed mb-12 max-w-3xl">
            Projekt rozpoczęliśmy w sytuacji, w której sklep miał duży potencjał, ale mierzył się z kilkoma istotnymi barierami ograniczającymi rozwój organicznej widoczności.
          </p>
          <div class="space-y-10">
            <div>
              <h3 class="font-bold text-white text-xl mb-3">Silna konkurencja ze strony dużych sieci handlowych</h3>
              <p class="text-gray-400 leading-relaxed">Największym wyzwaniem była konkurencja z dużymi markami, które podczas akcji tematycznych, takich jak tygodnie włoskie w Lidlu i Biedronce, szybko zdobywały wysokie pozycje na ogólne frazy typu „oliwa włoska" czy „makaron włoski". Konkurowanie wyłącznie ceną z tego typu ofertą nie było możliwe, dlatego konieczne było znalezienie innej przewagi.</p>
            </div>
            <div>
              <h3 class="font-bold text-white text-xl mb-3">Powielone opisy produktów</h3>
              <p class="text-gray-400 leading-relaxed">Aż 74% opisów produktów było skopiowanych bezpośrednio od dostawców. Te same treści pojawiały się w wielu innych sklepach internetowych, przez co marka nie wyróżniała się w wynikach wyszukiwania i nie budowała własnego autorytetu.</p>
            </div>
            <div>
              <h3 class="font-bold text-white text-xl mb-3">Kanibalizacja słów kluczowych</h3>
              <p class="text-gray-400 leading-relaxed">Sześć różnych kategorii konkurowało między sobą o tę samą frazę „makaron włoski". W efekcie żadna z nich nie mogła w pełni wykorzystać swojego potencjału i zdobyć silnej pozycji w Google.</p>
            </div>
            <div>
              <h3 class="font-bold text-white text-xl mb-3">Problemy techniczne serwisu</h3>
              <p class="text-gray-400 leading-relaxed">Strona wymagała uporządkowania od strony technicznej. Najważniejsze problemy obejmowały zbyt wolne ładowanie na urządzeniach mobilnych, nieoptymalną strukturę paginacji oraz brak odpowiedniej konfiguracji canonicali dla filtrów, które generowały setki podobnych adresów URL.</p>
            </div>
            <div>
              <h3 class="font-bold text-white text-xl mb-3">Brak sygnałów E-E-A-T</h3>
              <p class="text-gray-400 leading-relaxed">Serwis nie wykorzystywał elementów budujących zaufanie i eksperckość. Brakowało autorskich treści, podpisów autorów, biogramów oraz informacji pokazujących doświadczenie osób stojących za marką.</p>
            </div>
            <div>
              <h3 class="font-bold text-white text-xl mb-3">Sezonowość produktów</h3>
              <p class="text-gray-400 leading-relaxed">Część najważniejszych produktów była dostępna tylko przez ograniczony czas. Oliwa z nowego zbioru pojawiała się głównie od listopada do stycznia, a panettone było produktem typowo grudniowym. Istniało ryzyko utraty wypracowanych pozycji poza sezonem i konieczności każdorazowego odbudowywania widoczności.</p>
            </div>
          </div>
        </section>

        <!-- Sekcja 4: Cele projektu -->
        <section class="scroll-mt-32" id="cele">
          <h2 class="font-body text-[2rem] lg:text-[3rem] font-bold leading-tight mb-8">Cele projektu</h2>
          <p class="text-lg text-gray-600 leading-relaxed mb-10 max-w-3xl">
            Celem projektu było nie tylko zwiększenie widoczności w Google, ale przede wszystkim zbudowanie stabilnego kanału sprzedaży opartego na ruchu organicznym i autorytecie marki.
          </p>
          <div class="space-y-8">
            <div>
              <h3 class="font-bold text-xl mb-2">5-krotny wzrost ruchu organicznego w ciągu 24 miesięcy</h3>
              <p class="text-gray-600 leading-relaxed">Strategia zakładała systematyczne zwiększanie liczby użytkowników pozyskiwanych z bezpłatnych wyników wyszukiwania poprzez poprawę widoczności najważniejszych kategorii, produktów oraz treści eksperckich.</p>
            </div>
            <div>
              <h3 class="font-bold text-xl mb-2">TOP3 dla ponad 200 fraz produktowych i kategoryjnych</h3>
              <p class="text-gray-600 leading-relaxed">Jednym z głównych celów było zdobycie wysokich pozycji dla kluczowych zapytań zakupowych związanych z włoskimi produktami premium – zarówno na poziomie kategorii, jak i konkretnych produktów.</p>
            </div>
            <div>
              <h3 class="font-bold text-xl mb-2">Zwiększenie udziału ruchu organicznego w przychodach do minimum 40%</h3>
              <p class="text-gray-600 leading-relaxed">SEO miało stać się jednym z najważniejszych kanałów sprzedaży, generującym wartościowy ruch i zmniejszającym zależność od płatnych kampanii reklamowych.</p>
            </div>
            <div>
              <h3 class="font-bold text-xl mb-2">Obniżenie kosztu pozyskania klienta (CAC) o minimum 30%</h3>
              <p class="text-gray-600 leading-relaxed">Poprzez rozwój ruchu organicznego chcieliśmy ograniczyć konieczność ciągłego zwiększania wydatków na reklamy i poprawić efektywność pozyskiwania nowych klientów.</p>
            </div>
            <div>
              <h3 class="font-bold text-xl mb-2">Zbudowanie autorytetu tematycznego w obszarze włoskiej kuchni regionalnej</h3>
              <p class="text-gray-600 leading-relaxed">Projekt miał przekształcić sklep z miejsca sprzedaży produktów w rozpoznawalne źródło wiedzy o włoskiej kulturze kulinarnej – z eksperckimi treściami, historią regionów, poradnikami i rekomendacjami.</p>
            </div>
          </div>
        </section>

        <!-- Sekcja 5: Strategia i etapy projektu -->
        <section class="scroll-mt-32" id="strategia">
          <h2 class="font-body text-[2rem] lg:text-[3rem] font-bold leading-tight mb-16">Strategia i etapy projektu</h2>
          <div class="relative border-l border-gray-300 ml-4 space-y-16 lg:space-y-24">
            <!-- Faza 1 -->
            <div class="relative pl-12">
              <div class="absolute -left-[9px] top-0 w-4 h-4 rounded-full bg-accent" style="box-shadow: 0 0 0 4px rgba(139, 0, 41, 0.2);"></div>
              <p class="font-mono text-accent mb-2 text-sm">FAZA 1: AUDYT I STRATEGIA (CZERWIEC – SIERPIEŃ 2024)</p>
              <h3 class="font-body text-[1.5rem] lg:text-[2rem] font-bold mb-4">Audyt i strategia</h3>
              <p class="text-gray-600 leading-relaxed mb-6 max-w-3xl">Pierwszym etapem projektu była szczegółowa analiza całego serwisu oraz przygotowanie długofalowej strategii SEO. Zamiast od razu wdrażać pojedyncze zmiany, poświęciliśmy 12 tygodni na dokładną diagnozę, aby późniejsze działania były precyzyjnie ukierunkowane i przynosiły maksymalny efekt.</p>
              <div class="space-y-5">
                <div>
                  <h4 class="font-bold mb-1">Audyt techniczny serwisu</h4>
                  <p class="text-gray-600 leading-relaxed">Przeprowadziliśmy kompleksowy audyt techniczny z wykorzystaniem narzędzi Screaming Frog, Sitebulb oraz PageSpeed Insights. Wykryliśmy ponad 330 istotnych problemów technicznych, z czego 95 zostało zakwalifikowanych jako priorytetowe do natychmiastowej poprawy.</p>
                </div>
                <div>
                  <h4 class="font-bold mb-1">Analiza treści i architektury informacji</h4>
                  <p class="text-gray-600 leading-relaxed">Przeanalizowaliśmy strukturę ponad 1400 adresów URL, klasyfikując je pod kątem jakości i przydatności: unikalne treści, duplikaty, strony o niskiej wartości oraz przypadki kanibalizacji słów kluczowych. Pozwoliło to określić, które elementy serwisu wymagają rozbudowy, połączenia lub usunięcia.</p>
                </div>
                <div>
                  <h4 class="font-bold mb-1">Strategiczne badanie słów kluczowych</h4>
                  <p class="text-gray-600 leading-relaxed">Przygotowaliśmy bazę ponad 6400 fraz podzielonych według intencji użytkownika: zapytania zakupowe, informacyjne, porównawcze, długiego ogona związane z przepisami oraz frazy brandowe. Dzięki temu mogliśmy budować treści odpowiadające różnym etapom decyzji zakupowej.</p>
                </div>
                <div>
                  <h4 class="font-bold mb-1">Analiza konkurencji</h4>

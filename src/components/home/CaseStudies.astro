---
import { Picture } from 'astro:assets';
import SectionHeader from "../ui/SectionHeader.astro";
import heroImage from "../../assets/case-studies/hero-wloskie-delikatesy.jpg";
import rumImage from "../../assets/case-studies/case-study-rum.png";
---

<section
  id="wyniki"
  class="px-4 sm:px-6 lg:px-8 py-24 lg:py-32 bg-white overflow-hidden"
>
  <div class="max-w-[1400px] mx-auto mb-16">
    <SectionHeader
      label="CASE STUDIES"
      title="Wyniki, które mówią<br />same za siebie"
    />
  </div>

  <div class="max-w-[1400px] mx-auto space-y-8">
    <!-- CS 1 - Image left, content right -->
    <a
      href="/case-studies/wzrost-ruchu-organicznego-o-800-w-e-commerce-z-wloskimi-delikatesami"
      class="grid grid-cols-1 lg:grid-cols-2 gap-0 bg-white border-2 border-gray-200 rounded-2xl overflow-hidden transition-all duration-300 hover:border-accent hover:shadow-2xl"
      data-reveal
    >
      <div class="relative min-h-[300px] lg:min-h-[420px] overflow-hidden">
        <Picture
          src={heroImage}
          alt="E-commerce z włoskimi delikatesami - case study SEO"
          widths={[400, 800, 1200]}
          sizes="(max-width: 1024px) 100vw, 50vw"
          class="absolute inset-0 w-full h-full object-cover"
          loading="lazy"
        />
        <div
          class="absolute bottom-6 left-6 font-mono text-[0.75rem] font-bold tracking-[0.1em] text-white bg-black/50 backdrop-blur-md px-4 py-2 rounded-md uppercase z-10"
        >
          E-COMMERCE
        </div>
      </div>
      <div class="p-8 lg:p-16 flex flex-col justify-center">
        <h3
          class="font-display text-2xl lg:text-[2.25rem] font-bold mb-6 leading-[1.3]"
        >
          Wzrost ruchu organicznego o 800% w e-commerce z włoskimi delikatesami
        </h3>
        <p class="text-gray-600 leading-[1.8] mb-10 text-[1rem]">
          W 24 miesiące zwiększyliśmy ruch organiczny o 800%, konwersję o 121% i udział organic w przychodach z 14% do 47%. Strategia: SEO techniczne, content hubs regionalne, programmatic SEO z ludzką redakcją i link building.
        </p>
        <div
          class="grid grid-cols-1 sm:grid-cols-3 gap-8 pt-8 border-t-2 border-gray-100"
        >
          <div>
            <div
              class="font-mono text-3xl lg:text-[2.75rem] font-bold text-accent leading-none mb-2"
            >
              800%
            </div>
            <div
              class="text-[0.8rem] text-gray-500 uppercase tracking-widest font-semibold"
            >
              wzrost ruchu
            </div>
          </div>
          <div>
            <div
              class="font-mono text-3xl lg:text-[2.75rem] font-bold text-accent leading-none mb-2"
            >
              390
            </div>
            <div
              class="text-[0.8rem] text-gray-500 uppercase tracking-widest font-semibold"
            >
              słowa w TOP 3
            </div>
          </div>
          <div>
            <div
              class="font-mono text-3xl lg:text-[2.75rem] font-bold text-accent leading-none mb-2"
            >
              121%
            </div>
            <div
              class="text-[0.8rem] text-gray-500 uppercase tracking-widest font-semibold"
            >
              wzrost konwersji
            </div>
          </div>
        </div>
      </div>
    </a>

    <!-- CS 2 - Content left, gradient right -->
    <a
      href="/case-studies/real-user-monitoring-rum-wydajnosc-ecommerce"
      class="grid grid-cols-1 lg:grid-cols-2 gap-0 bg-white border-2 border-gray-200 rounded-2xl overflow-hidden transition-all duration-300 hover:border-accent hover:shadow-2xl"
      data-reveal
    >
      <div class="order-2 lg:order-1 p-8 lg:p-16 flex flex-col justify-center">
        <h3
          class="font-display text-2xl lg:text-[2.25rem] font-bold mb-6 leading-[1.3]"
        >
          Real User Monitoring: Jak przestaliśmy zgadywać i wskazaliśmy IT, co dokładnie psuje sprzedaż w e-commerce
        </h3>
        <p class="text-gray-600 leading-[1.8] mb-10 text-[1rem]">
          Projekt i wdrożenie systemu analityki wydajności opartego na danych od realnych użytkowników (RUM). Zgromadziliśmy ponad 329 000 zwalidowanych zdarzeń z 566 kluczowych adresów URL i wskazaliśmy IT konkretne błędy psujące sprzedaż.
        </p>
        <div
          class="grid grid-cols-1 sm:grid-cols-3 gap-8 pt-8 border-t-2 border-gray-100"
        >
          <div>
            <div
              class="font-mono text-3xl lg:text-[2.75rem] font-bold text-accent leading-none mb-2"
            >
              329k+
            </div>
            <div
              class="text-[0.8rem] text-gray-500 uppercase tracking-widest font-semibold"
            >
              zwalidowane zdarzenia
            </div>
          </div>
          <div>
            <div
              class="font-mono text-3xl lg:text-[2.75rem] font-bold text-accent leading-none mb-2"
            >
              566
            </div>
            <div
              class="text-[0.8rem] text-gray-500 uppercase tracking-widest font-semibold"
            >
              monitorowane URL
            </div>
          </div>
          <div>
            <div
              class="font-mono text-3xl lg:text-[2.75rem] font-bold text-accent leading-none mb-2"
            >
              5
            </div>
            <div
              class="text-[0.8rem] text-gray-500 uppercase tracking-widest font-semibold"
            >
              warstw systemu
            </div>
          </div>
        </div>
      </div>
      <div class="order-1 lg:order-2 relative min-h-[300px] lg:min-h-[420px] overflow-hidden">
        <Picture
          src={rumImage}
          alt="Real User Monitoring - wydajność e-commerce"
          widths={[400, 800, 1200]}
          sizes="(max-width: 1024px) 100vw, 50vw"
          class="absolute inset-0 w-full h-full object-cover"
          loading="lazy"
        />
        <div
          class="absolute bottom-6 left-6 font-mono text-[0.75rem] font-bold tracking-[0.1em] text-white bg-black/50 backdrop-blur-md px-4 py-2 rounded-md uppercase z-10"
        >
          WYDAJNOŚĆ
        </div>
      </div>
    </a>
  </div>

  <!-- Link to all case studies -->
  <div class="max-w-[1400px] mx-auto mt-16 text-center">
    <a
      href="/case-studies"
      class="inline-flex items-center gap-2 px-8 py-4 bg-black text-white font-bold rounded-lg hover:bg-accent transition-all duration-300 hover:scale-105 active:scale-95"
    >
      Zobacz wszystkie case studies
      <svg
        class="w-5 h-5"
        fill="none"
        stroke="currentColor"
        viewBox="0 0 24 24"
      >
        <path d="M5 12h14M12 5l7 7-7 7" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
      </svg>
    </a>
  </div>
</section>

